<?xml version="1.0" encoding="utf-8"?>
<!--
  A feed narrowing as it runs downward, met by a solid floor: the scroll, stopped.

  The three white bars are the same pill shape the app draws its charts with. The floor is the
  amber the goal meter turns when you approach your limit, so the icon carries the product's
  own colour language. The gap above the floor is deliberately more than twice the gap between
  the feed bars — that break is what makes the floor read as something hit rather than as a
  fourth item in the list.

  All of it sits inside a 40x50 box centred on the 108dp viewport, well within the 72dp circle
  every launcher mask is guaranteed to keep.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,29 H68 A4,4 0 0 1 68,37 H40 A4,4 0 0 1 40,29 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M46,41 H62 A4,4 0 0 1 62,49 H46 A4,4 0 0 1 46,41 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52,53 H56 A4,4 0 0 1 56,61 H52 A4,4 0 0 1 52,53 Z" />
    <path
        android:fillColor="#FFFAB219"
        android:pathData="M38.5,70 H69.5 A4.5,4.5 0 0 1 69.5,79 H38.5 A4.5,4.5 0 0 1 38.5,70 Z" />
</vector>
