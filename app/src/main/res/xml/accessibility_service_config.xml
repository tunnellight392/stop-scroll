<?xml version="1.0" encoding="utf-8"?>
<!--
  Only typeViewScrolled is requested: StopScroll needs to know that a scrollable container
  moved, and nothing else. flagReportViewIds is required so the scrolling view's resource id
  is available, which is how a Reels player is told apart from the Instagram grid.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_summary" />
